{
  "name": "flash-sale",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "server": "pnpm --filter backend dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm --prefix backend run db:migrate",
    "test": "pnpm --filter backend exec vitest run",
    "test:integration": "pnpm --filter backend exec vitest run tests/integration",
    "test:integration:setup": "pnpm docker:up && pnpm db:migrate && pnpm test:integration",
    "test:stress": "./stress-tests/run.sh"
  },
  "packageManager": "pnpm@8.10.2",
  "workspaces": [
    "frontend",
    "backend"
  ]
}
